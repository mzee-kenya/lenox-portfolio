# Copy to .env for local development. Never commit the .env file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is used by default. To run on PostgreSQL, set POSTGRES_DB (or DATABASE_URL).
# POSTGRES_DB=lenox_portfolio
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional AI provider for richer resume-assistant responses.
# The deterministic matching engine works without this key.
# AI_API_KEY=
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini